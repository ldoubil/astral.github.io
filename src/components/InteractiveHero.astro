---
export interface Props {
  title?: string;
  tagline?: string;
  actions?: Array<{
    text: string;
    link: string;
    variant?: 'primary' | 'secondary';
  }>;
}

const {
  title = 'Astral',
  tagline = '跨平台 P2P 游戏联机软件，轻松实现多人联机',
  actions
} = Astro.props;

const defaultActions = [
  {
    text: '快速开始',
    link: '/quick-start/what-is-astral/',
    variant: 'primary' as const
  },
  {
    text: '下载应用',
    link: '/quick-start/download-install/',
    variant: 'secondary' as const
  },
  {
    text: '前往新版',
    link: 'https://next.astral.fan/',
    variant: 'secondary' as const
  }
];

const heroActions = actions && actions.length ? actions : defaultActions;
---

<div class="hero-wrapper">
  <a class="astral-next-banner" href="https://next.astral.fan/" rel="noopener">
    <span class="banner-badge">NEW</span>
    <span class="banner-text">Astral Game 已上线，前往 next.astral.fan</span>
    <span class="banner-arrow" aria-hidden="true">→</span>
  </a>

  <div class="hero-container">
    <h1 class="hero-title-sr">{title}</h1>

    <div class="astral-logo">
      <canvas id="astral-canvas" class="logo-text-canvas" aria-hidden="true"></canvas>
    </div>

    {tagline && <p class="logo-tagline">{tagline}</p>}

    <div class="hero-actions">
      {heroActions.map((action) => {
        const isNext = action.link.includes('next.astral.fan');
        return (
          <a
            href={action.link}
            class={`action-button ${action.variant || 'secondary'}${isNext ? ' action-next' : ''}`}
            target={action.link.startsWith('http') && !isNext ? '_blank' : undefined}
            rel={action.link.startsWith('http') ? 'noopener' : undefined}
          >
            <span>{action.text}</span>
            {isNext && <span class="action-badge">新</span>}
          </a>
        );
      })}
    </div>
  </div>
</div>

<script>
// @ts-nocheck
class StardustText {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.particles = [];
    this.text = 'Astral';
    this.mouse = { x: -9999, y: -9999 };
    this.isHovering = false;
    this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    this.init();
    this.bindEvents();

    if (this.reduced) {
      this.drawStatic();
    } else {
      this.animate();
    }
  }

  bindEvents() {
    this.canvas.addEventListener('mousemove', (e) => {
      const rect = this.canvas.getBoundingClientRect();
      this.mouse.x = (e.clientX - rect.left) * (this.width / rect.width);
      this.mouse.y = (e.clientY - rect.top) * (this.height / rect.height);
      this.isHovering = true;
    });

    this.canvas.addEventListener('mouseenter', () => {
      this.isHovering = true;
      this.canvas.style.cursor = 'pointer';
    });

    this.canvas.addEventListener('mouseleave', () => {
      this.isHovering = false;
      this.mouse.x = -9999;
      this.mouse.y = -9999;
      this.canvas.style.cursor = 'default';
    });

    this.canvas.addEventListener('click', () => {
      this.createExplosion();
    });

    window.addEventListener('resize', () => {
      clearTimeout(this.resizeTimeout);
      this.resizeTimeout = setTimeout(() => {
        this.init();
        if (this.reduced) this.drawStatic();
      }, 200);
    });

    const themeObserver = new MutationObserver(() => {
      if (this.reduced) this.drawStatic();
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });
  }

  createExplosion() {
    this.particles.forEach((particle) => {
      const dx = particle.x - this.mouse.x;
      const dy = particle.y - this.mouse.y;
      const distance = Math.sqrt(dx * dx + dy * dy) || 1;
      const force = Math.max(0, 150 - distance) / 150;

      particle.vx += (dx / distance) * force * 5;
      particle.vy += (dy / distance) * force * 5;
      particle.size += force * 2;
      particle.explosionTime = Date.now();
    });
  }

  init() {
    const rect = this.canvas.getBoundingClientRect();
    const width = Math.max(240, Math.round(rect.width) || 440);
    const height = Math.round(width * 0.3);
    const fontSize = Math.round(height * 0.66);
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    this.width = width;
    this.height = height;
    this.fontSize = fontSize;

    this.canvas.width = width * dpr;
    this.canvas.height = height * dpr;
    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const tempCanvas = document.createElement('canvas');
    const tempCtx = tempCanvas.getContext('2d');
    tempCanvas.width = width;
    tempCanvas.height = height;

    tempCtx.font = `800 ${fontSize}px -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif`;
    tempCtx.fillStyle = '#ffffff';
    tempCtx.textAlign = 'center';
    tempCtx.textBaseline = 'middle';
    tempCtx.fillText(this.text, width / 2, height / 2);

    const imageData = tempCtx.getImageData(0, 0, width, height);
    const pixels = imageData.data;

    this.particles = [];
    const gap = Math.max(4, Math.round(width / 100));

    for (let y = 0; y < height; y += gap) {
      for (let x = 0; x < width; x += gap) {
        const index = (y * width + x) * 4;
        if (pixels[index + 3] > 128) {
          this.particles.push(new Particle(x, y, width));
        }
      }
    }
  }

  drawBaseText() {
    const ctx = this.ctx;
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const gradient = ctx.createLinearGradient(0, 0, this.width, 0);

    if (isDark) {
      gradient.addColorStop(0, '#d7ddff');
      gradient.addColorStop(0.5, '#a9b5ff');
      gradient.addColorStop(1, '#c2a6ff');
    } else {
      gradient.addColorStop(0, '#4f57c8');
      gradient.addColorStop(0.5, '#667eea');
      gradient.addColorStop(1, '#8b5cf6');
    }

    ctx.save();
    ctx.font = `800 ${this.fontSize}px -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = gradient;
    ctx.fillText(this.text, this.width / 2, this.height / 2);
    ctx.restore();
  }

  drawStatic() {
    this.ctx.clearRect(0, 0, this.width, this.height);
    this.drawBaseText();
  }

  animate() {
    const ctx = this.ctx;
    ctx.clearRect(0, 0, this.width, this.height);

    // 底层实心渐变字保证可读性，粒子作为微光叠加
    this.drawBaseText();

    this.particles.forEach((particle) => {
      particle.update(this.mouse, this.isHovering);
      particle.draw(ctx);
    });

    requestAnimationFrame(() => this.animate());
  }
}

class Particle {
  constructor(targetX, targetY, canvasWidth) {
    this.targetX = targetX;
    this.targetY = targetY;
    this.x = targetX + (Math.random() - 0.5) * Math.min(100, canvasWidth * 0.3);
    this.y = targetY + (Math.random() - 0.5) * 100;
    this.vx = 0;
    this.vy = 0;
    this.size = Math.random() * 1.1 + 0.6;
    this.originalSize = this.size;
    this.alpha = Math.random() * 0.3 + 0.25;
    this.baseAlpha = this.alpha;
    this.twinkleSpeed = Math.random() * 0.02 + 0.01;
    this.twinkleOffset = Math.random() * Math.PI * 2;
    this.explosionTime = 0;

    this.hue = Math.random() * 60 + 200;
    this.saturation = Math.random() * 30 + 70;
    this.lightness = Math.random() * 20 + 75;
  }

  update(mouse, isHovering) {
    if (isHovering) {
      const dx = mouse.x - this.x;
      const dy = mouse.y - this.y;
      const distance = Math.sqrt(dx * dx + dy * dy);
      const maxDistance = 80;

      if (distance < maxDistance) {
        const force = (maxDistance - distance) / maxDistance;
        const angle = Math.atan2(dy, dx);

        this.vx += Math.cos(angle) * force * 0.3;
        this.vy += Math.sin(angle) * force * 0.3;

        this.size = this.originalSize * (1 + force * 0.5);
        this.alpha = this.baseAlpha * (1 + force * 0.6);
      } else {
        this.size = this.originalSize;
        this.alpha = this.baseAlpha;
      }
    }

    if (this.explosionTime > 0) {
      const elapsed = Date.now() - this.explosionTime;
      if (elapsed > 1000) {
        this.explosionTime = 0;
      } else {
        const recovery = elapsed / 1000;
        this.size = Math.max(this.originalSize, this.size * (1 - recovery * 0.1));
      }
    }

    const dx = this.targetX - this.x;
    const dy = this.targetY - this.y;

    this.vx += dx * 0.015;
    this.vy += dy * 0.015;

    this.vx *= 0.85;
    this.vy *= 0.85;

    this.x += this.vx;
    this.y += this.vy;

    const twinkle = Math.sin(Date.now() * this.twinkleSpeed + this.twinkleOffset) * 0.15;
    this.alpha = Math.max(0.12, this.baseAlpha + twinkle);
  }

  draw(ctx) {
    ctx.save();
    ctx.globalAlpha = this.alpha;

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const gradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size * 2.5);

    if (isDark) {
      gradient.addColorStop(0, `hsla(${this.hue + 20}, ${this.saturation}%, ${this.lightness + 10}%, 1)`);
      gradient.addColorStop(0.5, `hsla(${this.hue + 20}, ${this.saturation}%, ${this.lightness}%, 0.7)`);
      gradient.addColorStop(1, `hsla(${this.hue + 20}, ${this.saturation}%, ${this.lightness}%, 0)`);
    } else {
      gradient.addColorStop(0, `hsla(${this.hue}, ${this.saturation}%, ${this.lightness}%, 1)`);
      gradient.addColorStop(0.5, `hsla(${this.hue}, ${this.saturation}%, ${this.lightness}%, 0.8)`);
      gradient.addColorStop(1, `hsla(${this.hue}, ${this.saturation}%, ${this.lightness}%, 0)`);
    }

    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
  }
}

const canvas = document.getElementById('astral-canvas');
if (canvas) {
  new StardustText(canvas);
}
</script>

<style>
  .hero-wrapper {
    --h-accent: #4c58c9;
    --h-accent-2: #7c3aed;
    --h-text: #1a1b22;
    --h-muted: #5b6172;
    --h-border: rgba(91, 110, 232, 0.18);
    --h-surface: rgba(255, 255, 255, 0.6);
    --h-shadow: 0 10px 28px rgba(60, 70, 140, 0.12);
    --h-grid: rgba(30, 40, 90, 0.1);
    --h-glow: rgba(102, 126, 234, 0.16);

    position: relative;
    width: 100%;
  }

  :global([data-theme='dark']) .hero-wrapper {
    --h-accent: #a3b0ff;
    --h-accent-2: #c0a6ff;
    --h-text: #f2f3f8;
    --h-muted: #a0a4b8;
    --h-border: rgba(163, 176, 255, 0.2);
    --h-surface: rgba(163, 176, 255, 0.05);
    --h-shadow: 0 12px 32px rgba(0, 0, 0, 0.38);
    --h-grid: rgba(170, 185, 255, 0.14);
    --h-glow: rgba(139, 120, 255, 0.2);
  }

  /* 背景点阵，向四周淡出 */
  .hero-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(circle at 1px 1px, var(--h-grid) 1px, transparent 0);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 38%, #000 10%, transparent 72%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 38%, #000 10%, transparent 72%);
    pointer-events: none;
  }

  /* 中心柔光，向上延伸进顶栏下方，避免被容器切断 */
  .hero-wrapper::after {
    content: '';
    position: absolute;
    top: -220px;
    left: 50%;
    z-index: 0;
    width: min(900px, 100%);
    height: 560px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse 55% 50% at 50% 35%, var(--h-glow), transparent 70%);
    filter: blur(28px);
    pointer-events: none;
  }

  .hero-title-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* 顶部公告 */
  .astral-next-banner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    max-width: calc(100% - 2rem);
    margin: 1.1rem auto 0;
    padding: 0.35rem 0.85rem 0.35rem 0.4rem;
    border: 1px solid var(--h-border);
    border-radius: 999px;
    background: var(--h-surface);
    backdrop-filter: blur(10px);
    color: var(--h-text);
    font-size: 0.85rem;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .astral-next-banner:hover {
    transform: translateY(-1px);
    border-color: var(--h-accent);
    box-shadow: var(--h-shadow);
  }

  .banner-badge {
    flex-shrink: 0;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--h-accent), var(--h-accent-2));
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .banner-text {
    color: var(--h-text);
    font-weight: 500;
  }

  .banner-arrow {
    color: var(--h-accent);
    transition: transform 0.2s ease;
  }

  .astral-next-banner:hover .banner-arrow {
    transform: translateX(3px);
  }

  /* 主视觉 */
  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem clamp(2.5rem, 5vw, 3.75rem);
    text-align: center;
  }

  .astral-logo {
    width: min(100%, 460px);
  }

  .logo-text-canvas {
    display: block;
    width: 100%;
    aspect-ratio: 10 / 3;
    filter: drop-shadow(0 0 18px var(--h-glow));
  }

  .logo-tagline {
    max-width: 34em;
    margin: 0.75rem 0 0;
    color: var(--h-muted);
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    line-height: 1.7;
  }

  /* 按钮组 */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.72rem 1.35rem;
    border: 1px solid var(--h-border);
    border-radius: 999px;
    background: var(--h-surface);
    backdrop-filter: blur(10px);
    color: var(--h-text);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .action-button:hover {
    transform: translateY(-2px);
    border-color: var(--h-accent);
    box-shadow: var(--h-shadow);
  }

  .action-button:focus-visible {
    outline: 2px solid var(--h-accent);
    outline-offset: 3px;
  }

  .action-button.primary {
    border-color: transparent;
    background: linear-gradient(135deg, #5560d8, #7c46e6);
    color: #fff;
    box-shadow: 0 8px 22px rgba(102, 126, 234, 0.32);
  }

  .action-button.primary:hover {
    box-shadow: 0 12px 28px rgba(102, 126, 234, 0.42);
  }

  .action-button.action-next {
    border-color: rgba(102, 126, 234, 0.35);
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.12), rgba(139, 92, 246, 0.12));
    color: var(--h-accent);
  }

  .action-badge {
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    background: var(--h-accent);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.4;
  }

  :global([data-theme='dark']) .action-button.primary {
    color: #14152a;
    background: linear-gradient(135deg, #b9c3ff, #d0b8ff);
    box-shadow: 0 8px 24px rgba(139, 120, 255, 0.22);
  }

  :global([data-theme='dark']) .action-button.primary:hover {
    box-shadow: 0 12px 30px rgba(139, 120, 255, 0.32);
  }

  :global([data-theme='dark']) .action-badge {
    color: #14152a;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .astral-next-banner {
      margin-top: 0.85rem;
      padding: 0.3rem 0.65rem 0.3rem 0.35rem;
      font-size: 0.78rem;
    }

    .banner-text {
      line-height: 1.4;
    }

    .hero-container {
      padding: 2.25rem 1.25rem 2.5rem;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
      max-width: 420px;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }

    .action-button {
      width: 100%;
      padding: 0.75rem 0.75rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 420px) {
    .banner-text {
      font-size: 0.74rem;
    }

    .hero-container {
      padding: 1.75rem 1rem 2.25rem;
    }

    .logo-tagline {
      font-size: 0.9rem;
    }
  }
</style>
