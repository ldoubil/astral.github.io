---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import AmlJumpDialog from './AmlJumpDialog.astro';
---

<a
	href="https://aml.astral.fan/"
	class="aml-invite"
	data-aml-invite
	aria-label="AML MC启动器测试邀请"
	title="前往 AML · MC启动器测试"
>
	<span class="aml-invite-text">AML 启动器</span>
	<span class="aml-invite-arrow" aria-hidden="true">↗</span>
</a>

<span class="aml-invite-divider" aria-hidden="true"></span>

<a
	class="hd-icon"
	href="https://qm.qq.com/q/MGETTxg524"
	target="_blank"
	rel="noopener noreferrer"
	aria-label="QQ 群"
	title="QQ 群"
>
	<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path d="M20.5 13.6a4.6 4.6 0 0 1-4.6 4.6H8l-4 3.2v-3.7a4.6 4.6 0 0 1-1.5-3.4V9.4A4.6 4.6 0 0 1 8.1 4.8h7.8a4.6 4.6 0 0 1 4.6 4.6z" />
		<circle cx="8.6" cy="11.5" r="1" />
		<circle cx="12.5" cy="11.5" r="1" />
		<circle cx="16.4" cy="11.5" r="1" />
	</svg>
</a>

<a
	class="hd-icon"
	href="https://pd.qq.com/s/90vkmvwar"
	target="_blank"
	rel="noopener noreferrer"
	aria-label="腾讯频道"
	title="腾讯频道"
>
	<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<circle cx="6.5" cy="12" r="1.4" class="hd-fill" />
		<path d="M10.2 8.6a5 5 0 0 1 0 6.8" />
		<path d="M13.6 5.6a9.2 9.2 0 0 1 0 12.8" />
		<path d="M17 3.2a13 13 0 0 1 0 17.6" />
	</svg>
</a>

<a
	class="hd-icon"
	href="https://acg-n.cn"
	target="_blank"
	rel="noopener noreferrer"
	aria-label="教程博客 acg-n.cn"
	title="教程 · acg-n.cn"
>
	<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path d="M12 6.2c-1.6-1.5-3.8-2.2-6-2.2H4.4v14.4h1.6c2.2 0 4.4.7 6 2.2" />
		<path d="M12 6.2c1.6-1.5 3.8-2.2 6-2.2h1.6v14.4H18c-2.2 0-4.4.7-6 2.2" />
	</svg>
</a>

<Default><slot /></Default>
<AmlJumpDialog />

<style>
	.aml-invite {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: none;
		box-shadow: none;
		color: rgba(244, 241, 235, 0.55);
		text-decoration: none;
		transition: color 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.aml-invite:hover,
	.aml-invite:active {
		transform: none;
		background: none;
		box-shadow: none;
		color: #ff4d00;
	}

	.aml-invite-text {
		font-family: 'Anybody', 'Noto Sans SC', sans-serif;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		white-space: nowrap;
		line-height: 1.1;
		color: inherit;
	}

	.aml-invite-arrow {
		font-size: 11px;
		font-weight: 600;
		opacity: 0.7;
		transform: none;
		transition: opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.aml-invite:hover .aml-invite-arrow {
		opacity: 1;
		transform: none;
		color: inherit;
	}

	.aml-invite-divider {
		display: inline-block;
		width: 1px;
		height: 1rem;
		margin-inline: 0.15rem;
		background: rgba(244, 241, 235, 0.15);
		align-self: center;
		flex-shrink: 0;
	}

	@media (max-width: 50rem) {
		.aml-invite-text,
		.aml-invite-arrow {
			display: none;
		}
	}

	/* 顶栏图标：QQ 群 / 腾讯频道 / 教程博客，排在 GitHub 左侧 */
	:global(.social-icons) > a.hd-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 0;
		border-radius: 0;
		background: none;
		color: rgba(244, 241, 235, 0.55);
		text-decoration: none;
		transition: color 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	:global(.social-icons) > a.hd-icon svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	:global(.social-icons) > a.hd-icon .hd-fill {
		fill: currentColor;
		stroke: none;
	}

	:global(.social-icons) > a.hd-icon:hover,
	:global(.social-icons) > a.hd-icon:focus-visible {
		color: #ff4d00;
	}
</style>
